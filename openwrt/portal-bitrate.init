#!/bin/sh /etc/rc.common
# PS Portal high-bitrate relay — OpenWrt router-mode port
# Upstream: https://github.com/atameric/ps5-portal-high-bitrate (MIT)
START=99
STOP=10
USE_PROCD=1

PORTAL_DIR=/usr/lib/portal-bitrate
PORTAL_CFG=/etc/portal-bitrate/auto-config.json
PORTAL_RT=/var/lib/portal-bitrate

start_service() {
	[ -f "$PORTAL_CFG" ] || {
		echo "portal-bitrate: missing $PORTAL_CFG — run: portal-bitrate configure --interface br-lan --ps5-ip <ip> --portal-ip <ip>"
		return 1
	}
	mkdir -p "$PORTAL_RT"
	procd_open_instance
	procd_set_param command /usr/bin/python3 -u "$PORTAL_DIR/portal_auto.py" run --config "$PORTAL_CFG" --runtime "$PORTAL_RT"
	procd_set_param env PORTAL_BITRATE_ROUTER_MODE=1 PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 60
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "portal-bitrate"
}

stop_service() {
	# portal_auto.py handles SIGTERM: it stops the loop, lets the guardian
	# repair the Portal ARP entry and removes its scoped nftables table.
	:
}
